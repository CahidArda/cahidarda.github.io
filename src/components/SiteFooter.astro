---
import Cursor from './Cursor.astro';
import { profile } from '../data/profile';

interface Props {
  /** Smaller top gap, for pages where the footer is pinned to the screen bottom. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<footer
  class:list={[compact ? 'mt-8' : 'mt-20']}
  class="mx-auto w-full max-w-[100rem] px-5 side:px-8"
>
  <div
    class="flex flex-col items-center gap-4 border-t border-line py-6 sm:flex-row sm:justify-between"
  >
    <p class="label inline-flex items-center gap-3">
      <Cursor class="text-[0.9rem]" />
      {profile.name}, Istanbul, {new Date().getFullYear()}
    </p>
    <nav aria-label="Footer" class="flex gap-6">
      <a href="/articles" class="label hover:text-accent">Index</a>
      <a href="/rss.xml" class="label hover:text-accent">RSS</a>
      <a href="#top" class="label hover:text-accent">Top ↑</a>
    </nav>
  </div>
</footer>
