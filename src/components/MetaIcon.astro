---
// Small metadata icons (star count, external link). Paths from Tabler Icons
// (star-filled, arrow-up-right) — drawn on a 24x24 grid so they center cleanly.
interface Props {
  name: 'star' | 'link';
  class?: string;
}
const { name, class: className = 'h-4 w-4' } = Astro.props;
---

{
  name === 'star' ? (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M8.243 7.34l-6.38 .925l-.113 .023a1 1 0 0 0 -.44 1.684l4.622 4.499l-1.09 6.355l-.013 .11a1 1 0 0 0 1.464 .944l5.706 -3l5.693 3l.1 .046a1 1 0 0 0 1.352 -1.1l-1.091 -6.355l4.624 -4.5l.078 -.085a1 1 0 0 0 -.633 -1.62l-6.38 -.926l-2.852 -5.78a1 1 0 0 0 -1.794 0l-2.853 5.78z" />
    </svg>
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M17 7 7 17" />
      <path d="M8 7h9v9" />
    </svg>
  )
}
