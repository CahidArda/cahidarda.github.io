---
import TagBadge from './TagBadge.astro';
import MetaIcon from './MetaIcon.astro';
import { tagHref } from '../data/tags';
import type { ListEntry } from '../lib/entries';
import { formatDate, isoDate } from '../lib/format';

interface Props {
  entry: ListEntry;
}

const { entry } = Astro.props;
const { title, date, tags, href, external, source, stars } = entry;
---

<article
  class="group relative flex items-center justify-between gap-4 border-t border-line py-3"
>
  <!-- Left: title -->
  <h3 class="min-w-0 flex-1 truncate font-display text-base text-ink md:text-lg">
    <a
      href={href}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener' : undefined}
      class="after:absolute after:inset-0 hover:text-accent focus-visible:text-accent"
    >
      {title}
    </a>
  </h3>

  <!-- Right: metadata (hidden on mobile) then the tag, justified right -->
  <div class="flex shrink-0 items-center gap-3">
    <div class="label hidden items-center gap-3 sm:flex">
      {
        typeof stars === 'number' && stars > 0 && (
          <span class="inline-flex items-center gap-1">
            <MetaIcon name="star" />
            {stars}
          </span>
        )
      }
      {
        external && source && (
          <span class="inline-flex items-center gap-1 text-accent">
            <MetaIcon name="link" />
            {source}
          </span>
        )
      }
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
    </div>

    <div class="relative z-10 flex gap-1.5">
      {tags.map((tag) => <TagBadge tag={tag} href={tagHref(tag)} />)}
    </div>
  </div>
</article>
