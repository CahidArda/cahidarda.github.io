---
import Monogram from './Monogram.astro';
import { profile } from '../data/profile';
---

<section class="hero" aria-label="Introduction">
  <div class="hero-plate" aria-hidden="true">
    <span class="tick tl"></span><span class="tick tr"></span>
    <span class="tick bl"></span><span class="tick br"></span>
  </div>

  <div class="hero-bar label reveal r0">
    <span>{profile.name}</span>
    <span class="hidden sm:inline">Software / Agents / Infrastructure</span>
    <span>Istanbul, 41.0°N 28.9°E</span>
  </div>

  <div class="hero-body">
    <Monogram letter="A" class="reveal r0 text-[7rem] md:text-[10rem]" />
    <p class="hero-l1 reveal r1">Hi, I'm Arda.</p>
    <p class="hero-l2 reveal r2">I build for the next kind of user.</p>
    <p class="hero-l3 reveal r3">
      Engineer at Upstash, working on agent experience: infrastructure that AI agents can discover,
      understand, and operate on their own. On the side, long interactive essays about where
      automation is taking the rest of us.
    </p>
  </div>

  <a href="#main" class="hero-down reveal r4" aria-label="Scroll to content">
    <span class="label">Enter</span>
    <span class="bob text-2xl text-muted">↓</span>
  </a>
</section>
