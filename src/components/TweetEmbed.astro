---
/**
 * Shows an X post as a static image that links to the post.
 *
 * The images are rendered before each build and dev server by scripts/tweets.mjs,
 * which writes a light and a dark WebP to public/tweets/ and the post's metadata
 * to src/data/tweets/<id>.json (not committed; cached between deploys in CI).
 * Nothing is loaded from X when the page is viewed,
 * so there is no third-party script and no layout shift. The site theme (the
 * `.dark` class on <html>) picks which image shows.
 *
 * A post that could not be fetched and has no earlier render falls back to a
 * plain quote with a link.
 */
interface Props {
  url: string;
  /** Text for the fallback quote, used only when the post has not been rendered. */
  fallback?: string;
}

interface TweetMeta {
  id: string;
  url: string;
  name: string;
  handle: string;
  text: string;
  width: number;
  height: number;
}

const { url, fallback } = Astro.props;

const id = url.match(/\/status\/(\d+)/)?.[1];
const rendered = import.meta.glob<TweetMeta>('../data/tweets/*.json', {
  eager: true,
  import: 'default',
});
const meta = id ? rendered[`../data/tweets/${id}.json`] : undefined;

if (!meta) {
  console.warn(`[TweetEmbed] ${url} has no rendered image; showing a plain quote.`);
}

const alt = meta ? `Post by ${meta.name} (@${meta.handle}) on X: ${meta.text}` : '';
---

{
  meta ? (
    <a class="tweet-embed" href={url} target="_blank" rel="noopener">
      {(['light', 'dark'] as const).map((theme) => (
        <img
          class={`tweet-${theme}`}
          src={`/tweets/${meta.id}-${theme}.webp`}
          width={meta.width}
          height={meta.height}
          alt={alt}
          loading="lazy"
          decoding="async"
        />
      ))}
    </a>
  ) : (
    <blockquote class="tweet-fallback">
      {fallback && <p>{fallback}</p>}
      <a href={url}>{url}</a>
    </blockquote>
  )
}

<style>
  .tweet-embed {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
  }
  .tweet-embed img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0;
    border: 0;
  }
  .tweet-embed .tweet-dark {
    display: none;
  }
  :global(.dark) .tweet-embed .tweet-light {
    display: none;
  }
  :global(.dark) .tweet-embed .tweet-dark {
    display: block;
  }
</style>
