---
/**
 * Eight-pointed star seal (two interlaced squares, the Seljuk/Ottoman "sekiz
 * köşeli yıldız"), drawn in hairlines. Inherits color; size it with width classes.
 */
interface Props {
  class?: string;
  /** Draw the outer ring and inner rosette (off for tiny inline use). */
  detailed?: boolean;
}
const { class: className, detailed = true } = Astro.props;
---

<svg
  class:list={['seal', className]}
  viewBox="-50 -50 100 100"
  fill="none"
  stroke="currentColor"
  aria-hidden="true"
>
  {detailed && <circle r="47" stroke-width="0.6" opacity="0.55" />}
  <rect x="-30" y="-30" width="60" height="60" stroke-width="1.1"></rect>
  <rect x="-30" y="-30" width="60" height="60" stroke-width="1.1" transform="rotate(45)"></rect>
  {
    detailed && (
      <>
        <circle r="17" stroke-width="0.6" />
        <rect x="-10" y="-10" width="20" height="20" stroke-width="0.6" />
        <rect x="-10" y="-10" width="20" height="20" stroke-width="0.6" transform="rotate(45)" />
      </>
    )
  }
  <circle r="2.2" fill="currentColor" stroke="none"></circle>
</svg>
