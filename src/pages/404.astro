---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not Found" noindex>
  <section class="border-b border-line pb-10">
    <p class="label">Error 404</p>
    <h1 class="mt-4 font-display text-6xl text-ink md:text-7xl">Lost the thread.</h1>
    <p class="mt-4 max-w-xl text-ink-soft">
      That page doesn’t exist - it may have moved, or never did. Try the index, or jump somewhere
      with <kbd class="inline-flex items-center border border-line px-1.5 py-0.5 font-mono text-xs"
        >⌘ + K</kbd
      >.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="/"
        class="label inline-flex items-center border border-line-strong px-3 py-2 hover:border-accent hover:text-accent"
      >
        ← Home
      </a>
      <a
        href="/articles"
        class="label inline-flex items-center border border-line-strong px-3 py-2 hover:border-accent hover:text-accent"
      >
        Articles
      </a>
    </div>
  </section>
</BaseLayout>
