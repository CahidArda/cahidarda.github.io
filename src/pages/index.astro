---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleRowCompact from '../components/ArticleRowCompact.astro';
import Hero from '../components/Hero.astro';
import { getEntries } from '../lib/entries';

const RECENT_COUNT = 6;

const entries = await getEntries();
const recent = entries.slice(0, RECENT_COUNT);
---

<BaseLayout fillViewport>
  <Hero slot="hero" />

  <section>
    <div class="flex items-baseline justify-between">
      <h2 class="label">Recent work</h2>
      <a href="/articles" class="label hover:text-accent">Full index →</a>
    </div>

    <div class="mt-6 rounded-2xl border border-accent/30 bg-accent/5 p-5">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="label text-accent">New blog</p>
          <p class="mt-1 text-sm text-ink-soft">Open the latest article directly from the homepage.</p>
        </div>
        <a href="/articles" class="inline-flex items-center gap-2 rounded-full bg-accent px-4 py-2 text-sm font-medium text-white transition hover:opacity-90">
          Browse blog
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="mt-4">
      {recent.map((entry) => <ArticleRowCompact entry={entry} />)}
      {
        recent.length === 0 && (
          <p class="border-t border-line py-6 text-sm text-muted">No articles yet.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
