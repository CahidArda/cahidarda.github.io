---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { tags, tagKeys } from '../../data/tags';
import { getEntries } from '../../lib/entries';

const entries = await getEntries();

const ALL = '__all__';
const chips = [
  { key: ALL, label: 'All', count: entries.length },
  ...tagKeys
    .map((key) => ({
      key: key as string,
      label: tags[key].label,
      count: entries.filter((e) => e.tags.includes(key)).length,
    }))
    .filter((t) => t.count > 0),
];

// Secondary filter shown only under the Blog tag: where a post was published.
// Posts without a `source` live on this site. New sources appear automatically.
const SITE = 'site';
const sourceKey = (source?: string) =>
  source ? source.toLowerCase().replace(/[^a-z0-9]+/g, '-') : SITE;
const blogEntries = entries.filter((e) => e.tags.includes('blog'));
const sources = [
  { key: ALL, label: 'All sources', count: blogEntries.length },
  { key: SITE, label: 'This site', count: blogEntries.filter((e) => !e.source).length },
  ...[...new Set(blogEntries.map((e) => e.source).filter((x): x is string => Boolean(x)))].map(
    (label) => ({
      key: sourceKey(label),
      label,
      count: blogEntries.filter((e) => e.source === label).length,
    }),
  ),
].filter((s) => s.count > 0);
---

<BaseLayout title="Index" description="Writing, papers, projects, and monthly reading roundups.">
  <PageHeader
    title="Index"
    dek="Everything in one place: writing, publications, projects, and the monthly record. Filter by tag."
    backHref="/"
    backLabel="Home"
  >
    <span slot="meta" class="label">{entries.length} entries</span>
  </PageHeader>

  <div id="tag-filter" role="group" aria-label="Filter by tag" class="mt-10 flex flex-wrap gap-2">
    {
      chips.map((chip) => (
        <button
          type="button"
          data-chip={chip.key}
          aria-pressed="false"
          class="inline-flex items-center gap-1.5 border border-line-strong px-3 py-1 font-mono text-[0.7rem] tracking-[0.18em] text-ink-soft uppercase transition-colors hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-paper"
        >
          {chip.label}
          <span class="opacity-70">{chip.count}</span>
        </button>
      ))
    }
  </div>

  {
    sources.length > 2 && (
      <div
        id="source-filter"
        role="group"
        aria-label="Filter blog posts by source"
        hidden
        class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2"
      >
        <span class="label">Source</span>
        {sources.map((src) => (
          <button
            type="button"
            data-source-chip={src.key}
            aria-pressed="false"
            class="label border-b border-transparent pb-0.5 transition-colors hover:text-accent aria-pressed:border-accent aria-pressed:text-accent"
          >
            {src.label} <span class="opacity-60">{src.count}</span>
          </button>
        ))}
      </div>
    )
  }

  <!-- Active chip is set before paint (from ?tag=), so it never flashes "All" first. -->
  <script is:inline>
    (() => {
      const ALL = '__all__';
      const root = document.getElementById('tag-filter');
      if (!root) return;
      const chips = Array.from(root.querySelectorAll('[data-chip]'));
      const keys = chips.map((c) => c.getAttribute('data-chip'));
      const srcRoot = document.getElementById('source-filter');
      const srcChips = srcRoot ? Array.from(srcRoot.querySelectorAll('[data-source-chip]')) : [];
      const srcKeys = srcChips.map((c) => c.getAttribute('data-source-chip'));

      const state = () => {
        const q = new URLSearchParams(window.location.search);
        const t = q.get('tag');
        const tag = t && keys.includes(t) ? t : ALL;
        const s = q.get('source');
        // The source filter only exists under Blog; elsewhere it is ignored.
        const source = tag === 'blog' && s && srcKeys.includes(s) ? s : ALL;
        return { tag, source };
      };
      const paint = ({ tag, source }) => {
        chips.forEach((c) =>
          c.setAttribute('aria-pressed', String(c.getAttribute('data-chip') === tag)),
        );
        if (srcRoot) srcRoot.hidden = tag !== 'blog';
        srcChips.forEach((c) =>
          c.setAttribute('aria-pressed', String(c.getAttribute('data-source-chip') === source)),
        );
      };
      const filter = ({ tag, source }) => {
        let shown = 0;
        document.querySelectorAll('[data-article]').forEach((el) => {
          const t = (el.getAttribute('data-tags') || '').split(' ').filter(Boolean);
          const match =
            (tag === ALL || t.includes(tag)) &&
            (source === ALL || el.getAttribute('data-source') === source);
          el.hidden = !match;
          if (match) shown++;
        });
        const empty = document.getElementById('article-empty');
        if (empty) empty.hidden = shown !== 0;
      };
      const commit = (next) => {
        const url = new URL(window.location.href);
        if (next.tag === ALL) url.searchParams.delete('tag');
        else url.searchParams.set('tag', next.tag);
        if (next.source === ALL) url.searchParams.delete('source');
        else url.searchParams.set('source', next.source);
        window.history.replaceState({}, '', url);
        paint(next);
        filter(next);
        window.dispatchEvent(
          new CustomEvent('tagfilterchange', {
            detail: { tag: next.tag === ALL ? null : next.tag },
          }),
        );
      };

      // Highlight immediately (chips are already parsed); filter rows when the DOM is ready.
      paint(state());

      const init = () => {
        chips.forEach((chip) =>
          chip.addEventListener('click', () =>
            // Switching tag resets the source filter.
            commit({ tag: chip.getAttribute('data-chip'), source: ALL }),
          ),
        );
        srcChips.forEach((chip) =>
          chip.addEventListener('click', () =>
            commit({ tag: 'blog', source: chip.getAttribute('data-source-chip') }),
          ),
        );
        filter(state());
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
    })();
  </script>

  <div class="mt-4">
    {
      entries.map((entry) => (
        <div data-article data-tags={entry.tags.join(' ')} data-source={sourceKey(entry.source)}>
          <ArticleCard entry={entry} showDescription />
        </div>
      ))
    }
    <p id="article-empty" hidden class="border-t border-line py-6 text-sm text-muted">
      No articles match that tag.
    </p>
    {
      entries.length === 0 && (
        <p class="border-t border-line py-6 text-sm text-muted">No articles yet.</p>
      )
    }
  </div>
</BaseLayout>
