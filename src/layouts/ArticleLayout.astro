---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import SeriesNav from '../components/SeriesNav.astro';
import TagBadge from '../components/TagBadge.astro';
import CitationBlock from '../components/CitationBlock.astro';
import OrcidBadge from '../components/OrcidBadge.astro';
import PageHeader from '../components/PageHeader.astro';
import { tagHref } from '../data/tags';
import { formatDate, isoDate } from '../lib/format';
import { profile } from '../data/profile';

interface Props {
  entry: CollectionEntry<'articles'>;
  headings?: MarkdownHeading[];
}

const { entry, headings = [] } = Astro.props;
const { title, description, date, updated, tags, heroImage, venue, authors, doi, pdf } = entry.data;

const isPublication = tags.includes('publication');
// Per-article OG image generated at build time (see src/pages/og/[slug].png.ts).
const ogImage = `/og/${entry.id}.png`;
// Highlight this content type in the sidebar (publication/blog/accessions).
const activeNav = tags[0];
// Rough reading time from the raw source (MDX imports/JSX slightly inflate it).
const minutes = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 230));
// Every local article (blog posts, publications, The Current) opens with a drop cap.
const dropCap = tags.some((t) => t === 'blog' || t === 'publication' || t === 'accessions');

// Back-link: a member of a collection goes back to that collection's landing page;
// the landing page itself and standalone articles go back to the index. Used at the
// top (above the date) and in the footer.
let backHref = '/articles';
let backLabel = 'Index';
let seriesLanding: CollectionEntry<'articles'> | undefined;
if (entry.data.series) {
  seriesLanding = (
    await getCollection('articles', ({ data }) => data.seriesLanding === entry.data.series)
  )[0];
  if (seriesLanding) {
    backHref = `/articles/${seriesLanding.id}`;
    backLabel = seriesLanding.data.title;
  }
}

// Structured data: the article itself plus a breadcrumb trail (Home > Articles > series > page).
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const pageUrl = abs(`/articles/${entry.id}`);
const published = date.toISOString();
const modified = (updated ?? date).toISOString();
const crumbs = [
  { name: 'Home', url: abs('/') },
  { name: 'Articles', url: abs('/articles') },
  ...(seriesLanding
    ? [{ name: seriesLanding.data.title, url: abs(`/articles/${seriesLanding.id}`) }]
    : []),
  { name: title, url: pageUrl },
];
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.seoTitle ?? title,
    alternativeHeadline: entry.data.seoTitle ? title : undefined,
    description,
    url: pageUrl,
    mainEntityOfPage: pageUrl,
    image: abs(ogImage),
    datePublished: published,
    dateModified: modified,
    inLanguage: 'en',
    author: { '@type': 'Person', name: profile.name, url: abs('/') },
    publisher: { '@type': 'Person', name: profile.name, url: abs('/') },
    ...(seriesLanding
      ? {
          isPartOf: {
            '@type': 'CreativeWorkSeries',
            name: seriesLanding.data.title,
            url: abs(`/articles/${seriesLanding.id}`),
          },
        }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: c.url,
    })),
  },
];
---

<BaseLayout
  title={title}
  seoTitle={entry.data.seoTitle}
  ogType="article"
  published={published}
  modified={modified}
  jsonLd={jsonLd}
  description={description}
  ogImage={ogImage}
  activeNav={activeNav}
  headings={headings.filter((h) => h.depth === 2 || h.depth === 3)}
>
  <article>
    <PageHeader title={title} dek={description} backHref={backHref} backLabel={backLabel}>
      <Fragment slot="meta">
        {tags.map((tag) => <TagBadge tag={tag} href={tagHref(tag)} />)}
        {isPublication && <OrcidBadge />}
        <time datetime={isoDate(date)} class="label">{formatDate(date)}</time>
        {updated && <span class="label">/ Updated {formatDate(updated)}</span>}
        <span class="label">/ {minutes} min read</span>
      </Fragment>
      <hr class="mt-10 border-0 border-t border-line" />
    </PageHeader>

    {
      heroImage && (
        <div class="mt-8 border border-line">
          <Image src={heroImage} alt="" width={1280} height={720} class="w-full object-cover" />
        </div>
      )
    }

    {
      isPublication && (venue || authors || doi || pdf) && (
        <div class="mt-8">
          <CitationBlock
            title={title}
            authors={authors}
            venue={venue}
            date={date}
            doi={doi}
            pdf={pdf}
          />
        </div>
      )
    }

    <Prose class={dropCap ? 'prose-drop mt-10' : 'mt-10'}>
      <slot />
    </Prose>

    {entry.data.series && <SeriesNav entry={entry} />}
  </article>
</BaseLayout>
