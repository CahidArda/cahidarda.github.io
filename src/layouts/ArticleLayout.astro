---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import SeriesNav from '../components/SeriesNav.astro';
import TagBadge from '../components/TagBadge.astro';
import CitationBlock from '../components/CitationBlock.astro';
import OrcidBadge from '../components/OrcidBadge.astro';
import PageHeader from '../components/PageHeader.astro';
import { tagHref } from '../data/tags';
import { formatDate, isoDate } from '../lib/format';

interface Props {
  entry: CollectionEntry<'articles'>;
  headings?: MarkdownHeading[];
}

const { entry, headings = [] } = Astro.props;
const { title, description, date, updated, tags, heroImage, venue, authors, doi, pdf } = entry.data;

const isPublication = tags.includes('publication');
// Per-article OG image generated at build time (see src/pages/og/[slug].png.ts).
const ogImage = `/og/${entry.id}.png`;
// Highlight this content type in the sidebar (publication/blog/accessions).
const activeNav = tags[0];
// Rough reading time from the raw source (MDX imports/JSX slightly inflate it).
const minutes = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 230));
// Every local article (blog posts, publications, The Current) opens with a drop cap.
const dropCap = tags.some((t) => t === 'blog' || t === 'publication' || t === 'accessions');

// Back-link: a member of a collection goes back to that collection's landing page;
// the landing page itself and standalone articles go back to the index. Used at the
// top (above the date) and in the footer.
let backHref = '/articles';
let backLabel = 'Index';
if (entry.data.series) {
  const landing = (
    await getCollection('articles', ({ data }) => data.seriesLanding === entry.data.series)
  )[0];
  if (landing) {
    backHref = `/articles/${landing.id}`;
    backLabel = landing.data.title;
  }
}
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  activeNav={activeNav}
  headings={headings.filter((h) => h.depth === 2 || h.depth === 3)}
>
  <article>
    <PageHeader title={title} dek={description} backHref={backHref} backLabel={backLabel}>
      <Fragment slot="meta">
        {tags.map((tag) => <TagBadge tag={tag} href={tagHref(tag)} />)}
        {isPublication && <OrcidBadge />}
        <time datetime={isoDate(date)} class="label">{formatDate(date)}</time>
        {updated && <span class="label">/ Updated {formatDate(updated)}</span>}
        <span class="label">/ {minutes} min read</span>
      </Fragment>
      <hr class="mt-10 border-0 border-t border-line" />
    </PageHeader>

    {
      heroImage && (
        <div class="mt-8 border border-line">
          <Image src={heroImage} alt="" width={1280} height={720} class="w-full object-cover" />
        </div>
      )
    }

    {
      isPublication && (venue || authors || doi || pdf) && (
        <div class="mt-8">
          <CitationBlock
            title={title}
            authors={authors}
            venue={venue}
            date={date}
            doi={doi}
            pdf={pdf}
          />
        </div>
      )
    }

    <Prose class={dropCap ? 'prose-drop mt-10' : 'mt-10'}>
      <slot />
    </Prose>

    {entry.data.series && <SeriesNav entry={entry} />}

    <footer class="mt-12 border-t border-line pt-6">
      <a href={backHref} class="label inline-flex items-center gap-2 hover:text-accent">
        ← {backLabel}
      </a>
    </footer>
  </article>
</BaseLayout>
