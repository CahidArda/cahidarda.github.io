---
import '../styles/global.css';
import ProfileSidebar from '../components/ProfileSidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette, { type PaletteItem } from '../components/CommandPalette.tsx';
import { profile } from '../data/profile';
import { tags, tagKeys, tagHref } from '../data/tags';
import { getEntries } from '../lib/entries';
// Preload the primary (latin) font files so navigations don't flash the fallback (FOUT).
import frauncesFont from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative OG image URL. Defaults to the branded /og-card.png (source: scripts/og/og-card.html). */
  ogImage?: string;
  /** Render <meta name="robots" content="noindex"> (e.g. 404). */
  noindex?: boolean;
  /** Force a sidebar nav item active (e.g. 'publication' on a paper's page). */
  activeNav?: string;
  /** Article headings - rendered as an in-sidebar table of contents. */
  headings?: { depth: number; slug: string; text: string }[];
  /** Make the content grid at least one viewport tall, so a full-screen hero
   *  above it can scroll completely out of view (home page). */
  fillViewport?: boolean;
  /** Wide article layout (frontmatter `wideLayout: true`). On desktop the reading column
   *  sits at the viewport centre and `.fx-wide` plates grow equally on both sides, so they
   *  are centred too (CSS: "Wide article layout" in global.css). The sidebar's head scrolls
   *  away, its ToC dock sticks, and the sidebar eases left (scroll-linked transform, see
   *  wideScript) just far enough to clear the plates by the time the first one reaches it.
   *  Below 62rem nothing changes. */
  wide?: boolean;
}

const {
  title,
  description = profile.intro,
  ogImage = '/og-card.png',
  noindex = false,
  activeNav,
  headings = [],
  fillViewport = false,
  wide = false,
} = Astro.props;

const pageTitle = title ? `${title} - ${profile.name}` : `${profile.name} - Software Engineer`;
// `build.format: 'file'` means the build-time pathname carries an `.html` suffix
// (`/articles/foo.html`), but the sitemap and every internal link use the clean
// `/articles/foo` form. Strip the suffix so the canonical matches those, otherwise
// Google indexes the `.html` twin and reports the clean URL as an alternate page.
const canonicalPath = Astro.url.pathname.replace(/(?:\/index)?\.html$/, '') || '/';
const canonical = new URL(canonicalPath, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const twitterHandle = '@cahidarda';

// Build the command-palette index once, at build time (no runtime fetch).
// Tags jump to filters; every entry (articles, external posts, repos) is included,
// with its tag shown as the right-side badge.
const paletteItems: PaletteItem[] = [
  ...tagKeys.map((key) => ({
    title: tags[key].label,
    subtitle: tags[key].blurb,
    href: tagHref(key),
    external: false,
    badge: 'Tag',
  })),
  ...(await getEntries()).map((entry) => ({
    title: entry.title,
    subtitle: entry.source || entry.description || '',
    href: entry.href,
    external: entry.external,
    badge: tags[entry.tags[0]].label,
  })),
];

// Google tag (gtag.js), injected raw via set:html: a <script> nested inside a JSX
// expression breaks prettier-plugin-astro's parser, so keep the snippet as a string.
const gtagSnippet = `
<script async src="https://www.googletagmanager.com/gtag/js?id=G-JEFFYQNEL0"><\/script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  gtag('js', new Date());
  gtag('config', 'G-JEFFYQNEL0');
<\/script>`;

// Wide layout only (see the `wide` prop). Inlined as a string for the same prettier reason.
const wideScript = `(() => {
  // Wide layout: ease the sidebar left so it clears the centred wide plates (CSS in
  // global.css, "Wide article layout"). Distance S is measured, not assumed: just enough for
  // the dock to clear the first .fx-wide by 2rem. The move is tied to scroll position (no
  // timers), via one transform per frame, and is done by the time that plate's top reaches
  // the dock. If a plate sits beside the sidebar at load, the sidebar starts moved. Reduced
  // motion: the sidebar sits at its moved position from the start, nothing animates.
  const grid = document.querySelector('.layout-wide');
  const side = grid && grid.querySelector(':scope > header');
  const dock = side && side.querySelector('[data-dock]');
  const plate = grid && grid.querySelector('main .fx-wide');
  if (!side || !dock || !plate) return;
  const mqWide = matchMedia('(min-width: 62rem)');
  const mqCalm = matchMedia('(prefers-reduced-motion: reduce)');
  let S = 0, start = 0, end = 1, pre = false, shift = 0, queued = false;
  const set = (x) => {
    if (x === shift) return;
    shift = x;
    side.style.transform = x ? 'translate3d(' + (-x).toFixed(2) + 'px,0,0)' : '';
  };
  const frame = () => {
    queued = false;
    if (!S) return set(0);
    if (pre || mqCalm.matches) return set(S);
    const t = Math.min(1, Math.max(0, (scrollY - start) / (end - start)));
    set(S * t * t * (3 - 2 * t));
  };
  const queue = () => { if (!queued) { queued = true; requestAnimationFrame(frame); } };
  const measure = () => {
    if (!mqWide.matches) { S = 0; return queue(); }
    const y = scrollY;
    const r = side.getBoundingClientRect();
    const restLeft = r.left + shift, restRight = r.right + shift;
    const p = plate.getBoundingClientRect();
    const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
    S = Math.max(0, Math.min(restRight + 2 * rem - p.left, restLeft - 2 * rem));
    // Where the dock sits before it sticks: just below the head (the last element above it).
    let head = dock.previousElementSibling;
    while (head && !head.offsetHeight) head = head.previousElementSibling; // skip <script>s
    const gap = parseFloat(getComputedStyle(dock.parentElement).rowGap) || 0;
    const dockTop = (head ? head.getBoundingClientRect().bottom + y + gap : 0);
    const top = parseFloat(getComputedStyle(dock).top) || 0;
    const h = dock.offsetHeight;
    const P = p.top + y;
    pre = P < dockTop + h + 2 * rem;
    const meet = P - top - h - 2 * rem; // scrollY at which the plate reaches the stuck dock
    start = Math.max(0, Math.min(dockTop - top, meet - 150));
    end = Math.max(start + 1, Math.min(meet, start + 0.6 * innerHeight));
    queue();
  };
  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', measure);
  mqCalm.addEventListener('change', queue);
  new ResizeObserver(measure).observe(grid);
  measure();
})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google tag (gtag.js) — production builds only -->
    {import.meta.env.PROD && <Fragment set:html={gtagSnippet} />}
    <!-- End Google tag -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Preload primary fonts to avoid a flash of fallback text on navigation -->
    <link rel="preload" href={frauncesFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />

    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} - ${profile.tagline}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.name} - Articles`}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Set theme before paint to avoid a flash -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark =
            window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch {}
      })();
    </script>
  </head>

  <body id="top">
    <a
      href="#main"
      class="label sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:border focus:border-accent focus:bg-paper focus:px-3 focus:py-2"
    >
      Skip to content
    </a>

    <slot name="hero" />

    <!-- On the home page, content + footer together are exactly one screen tall
         (when the content fits), so the hero scrolls fully away with no dead space. -->
    <div id="content" class:list={[fillViewport && 'flex min-h-svh flex-col']}>
      <div
        class:list={[fillViewport && 'flex-1 content-start', wide && 'layout-wide']}
        class="mx-auto grid w-full max-w-[100rem] gap-y-8 px-5 py-8 side:grid-cols-[18rem_52rem_minmax(0,18rem)] side:gap-x-12 side:px-8 side:py-14"
      >
        <header class="side:sticky side:top-14 side:h-fit">
          <ProfileSidebar activeNav={activeNav} headings={headings} wide={wide} />
        </header>

        <main id="main" class="min-w-0">
          <slot />
        </main>
      </div>

      <SiteFooter compact={fillViewport} />
    </div>

    <CommandPalette items={paletteItems} client:idle />

    {wide && <script is:inline set:html={wideScript} />}
  </body>
</html>
